<view class="confirm-order-container data-v-2f2cf9ec"><view data-event-opts="{{[['tap',[['selectAddress',['$event']]]]]}}" class="section address-section data-v-2f2cf9ec" bindtap="__e"><block wx:if="{{selectedAddress}}"><view class="address-content data-v-2f2cf9ec"><view class="address-info data-v-2f2cf9ec"><view class="user-info data-v-2f2cf9ec"><text class="username data-v-2f2cf9ec">{{selectedAddress.receiverName}}</text><text class="phone data-v-2f2cf9ec">{{selectedAddress.receiverPhone}}</text></view><view class="address-detail data-v-2f2cf9ec">{{''+selectedAddress.province+" "+selectedAddress.city+"\n          "+selectedAddress.district+" "+selectedAddress.detailAddress+''}}</view></view><text class="arrow data-v-2f2cf9ec">></text></view></block><block wx:else><view class="no-address data-v-2f2cf9ec"><text class="data-v-2f2cf9ec">请选择收货地址</text><text class="arrow data-v-2f2cf9ec">></text></view></block></view><view class="section goods-section data-v-2f2cf9ec"><view class="goods-list data-v-2f2cf9ec"><block wx:for="{{$root.l0}}" wx:for-item="item" wx:for-index="__i0__" wx:key="bookId"><view class="goods-item data-v-2f2cf9ec"><image class="goods-cover data-v-2f2cf9ec" src="{{item.m0}}" mode="aspectFill"></image><view class="goods-info data-v-2f2cf9ec"><text class="goods-name data-v-2f2cf9ec">{{item.$orig.bookName||"未知书名"}}</text><view class="goods-bottom data-v-2f2cf9ec"><text class="goods-price data-v-2f2cf9ec">{{"¥"+item.m1}}</text><text class="goods-quantity data-v-2f2cf9ec">{{"x"+item.$orig.quantity}}</text></view></view></view></block></view></view><view class="section order-info data-v-2f2cf9ec"><view class="info-item data-v-2f2cf9ec"><text class="label data-v-2f2cf9ec">商品金额</text><text class="value data-v-2f2cf9ec">{{"¥"+formatTotalPrice}}</text></view><view class="info-item data-v-2f2cf9ec"><text class="label data-v-2f2cf9ec">运费</text><text class="value data-v-2f2cf9ec">¥0.00</text></view><view class="info-item data-v-2f2cf9ec"><text class="label data-v-2f2cf9ec">备注</text><input class="remark-input data-v-2f2cf9ec" placeholder="选填，可备注特殊需求" placeholder-class="placeholder" data-event-opts="{{[['input',[['__set_model',['','remark','$event',[]]]]]]}}" value="{{remark}}" bindinput="__e"/></view></view><view class="bottom-bar data-v-2f2cf9ec"><view class="total-section data-v-2f2cf9ec"><text class="total-label data-v-2f2cf9ec">合计：</text><text class="total-price data-v-2f2cf9ec">{{"¥"+formatTotalPrice}}</text><text class="payment-hint data-v-2f2cf9ec">微信支付</text></view><button class="btn-submit data-v-2f2cf9ec" loading="{{submitting}}" data-event-opts="{{[['tap',[['submitOrder',['$event']]]]]}}" bindtap="__e">{{''+(submitting?"提交中...":"提交订单")+''}}</button></view></view>