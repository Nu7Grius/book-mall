/* 分类选择弹窗 */
.category-popup.data-v-92bb8f34 {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  z-index: 999;
}
.popup-mask.data-v-92bb8f34 {
  position: absolute;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background-color: rgba(0, 0, 0, 0.5);
}
.popup-content.data-v-92bb8f34 {
  position: absolute;
  bottom: 0;
  left: 0;
  right: 0;
  height: 70vh;
  background-color: #fff;
  border-radius: 32rpx 32rpx 0 0;
}
.popup-header.data-v-92bb8f34 {
  display: flex;
  justify-content: space-between;
