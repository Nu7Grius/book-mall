<view class="register-container data-v-891c2434"><view class="register-header data-v-891c2434"><text class="title data-v-891c2434">用户注册</text><text class="subtitle data-v-891c2434">创建您的 OpenBook 账号</text></view><view class="register-form data-v-891c2434"><view class="form-item data-v-891c2434"><view class="label data-v-891c2434">用户名</view><input class="input data-v-891c2434" placeholder="请输入用户名" placeholder-class="placeholder" data-event-opts="{{[['input',[['__set_model',['$0','username','$event',[]],['formData']]]]]}}" value="{{formData.username}}" bindinput="__e"/></view><view class="form-item data-v-891c2434"><view class="label data-v-891c2434">密码</view><view class="input-wrapper data-v-891c2434"><input class="input data-v-891c2434" password="{{!showPassword}}" placeholder="请输入密码（6-20位）" placeholder-class="placeholder" data-event-opts="{{[['input',[['__set_model',['$0','password','$event',[]],['formData']]]]]}}" value="{{formData.password}}" bindinput="__e"/><button data-event-opts="{{[['tap',[['e0',['$event']]]]]}}" class="password-toggle data-v-891c2434" bindtap="__e">{{''+(showPassword?"隐藏":"显示")+''}}</button></view></view><view class="form-item data-v-891c2434"><view class="label data-v-891c2434">确认密码</view><view class="input-wrapper data-v-891c2434"><input class="input data-v-891c2434" password="{{!showConfirmPassword}}" placeholder="请再次输入密码" placeholder-class="placeholder" data-event-opts="{{[['input',[['__set_model',['','confirmPassword','$event',[]]]]]]}}" value="{{confirmPassword}}" bindinput="__e"/><button data-event-opts="{{[['tap',[['e1',['$event']]]]]}}" class="password-toggle data-v-891c2434" bindtap="__e">{{''+(showConfirmPassword?"隐藏":"显示")+''}}</button></view></view><view class="form-item data-v-891c2434"><view class="label data-v-891c2434">真实姓名</view><input class="input data-v-891c2434" placeholder="请输入真实姓名" placeholder-class="placeholder" data-event-opts="{{[['input',[['__set_model',['$0','realName','$event',[]],['formData']]]]]}}" value="{{formData.realName}}" bindinput="__e"/></view><view class="form-item data-v-891c2434"><view class="label data-v-891c2434">手机号</view><input class="input data-v-891c2434" type="number" maxlength="11" placeholder="请输入手机号" placeholder-class="placeholder" data-event-opts="{{[['input',[['__set_model',['$0','phone','$event',[]],['formData']]]]]}}" value="{{formData.phone}}" bindinput="__e"/></view><view class="form-item data-v-891c2434"><view class="label data-v-891c2434">邮箱</view><input class="input data-v-891c2434" type="text" placeholder="请输入邮箱（选填）" placeholder-class="placeholder" data-event-opts="{{[['input',[['__set_model',['$0','email','$event',[]],['formData']]]]]}}" value="{{formData.email}}" bindinput="__e"/></view><button class="btn-register data-v-891c2434" loading="{{loading}}" data-event-opts="{{[['tap',[['handleRegister',['$event']]]]]}}" bindtap="__e">{{''+(loading?"注册中...":"注册")+''}}</button><view class="login-link data-v-891c2434"><text class="data-v-891c2434">已有账号？</text><text data-event-opts="{{[['tap',[['goToLogin',['$event']]]]]}}" class="link data-v-891c2434" bindtap="__e">立即登录</text></view></view></view>