<view class="refund-detail-container data-v-3847af48"><block wx:if="{{loading}}"><view class="loading-section data-v-3847af48"><text class="data-v-3847af48">加载中...</text></view></block><block wx:else><block wx:if="{{refundDetail}}"><view class="refund-content data-v-3847af48"><view class="amount-card data-v-3847af48"><view class="amount-label data-v-3847af48">退款金额</view><view class="amount-value data-v-3847af48">{{"¥"+refundAmount}}</view></view><view class="section goods-section data-v-3847af48"><view class="goods-card data-v-3847af48"><image class="goods-cover data-v-3847af48" src="{{goodsInfo.coverImage}}" mode="aspectFill" data-event-opts="{{[['error',[['handleImageError',['$event']]]]]}}" binderror="__e"></image><view class="goods-info data-v-3847af48"><text class="goods-name data-v-3847af48">{{goodsInfo.bookName||"未知书名"}}</text><block wx:if="{{goodsInfo.author}}"><text class="goods-author data-v-3847af48">{{goodsInfo.author}}</text></block><view class="goods-bottom data-v-3847af48"><text class="goods-price data-v-3847af48">{{"¥"+goodsInfo.price}}</text><text class="goods-quantity data-v-3847af48">{{"x"+(goodsInfo.quantity||1)}}</text></view></view></view></view><view class="section status-section data-v-3847af48"><view class="{{['status-badge','data-v-3847af48',statusBadgeClass]}}"><text class="status-icon data-v-3847af48">{{statusBadgeIcon}}</text><text class="status-text data-v-3847af48">{{refundDetail.refundStatus}}</text></view></view><view class="section info-section data-v-3847af48"><view class="info-row data-v-3847af48"><text class="label data-v-3847af48">退款原因</text><text class="value data-v-3847af48">{{refundDetail.refundReason||"未填写"}}</text></view><block wx:if="{{refundDetail.refundDescription}}"><view class="info-row data-v-3847af48"><text class="label data-v-3847af48">详细说明</text><text class="value data-v-3847af48">{{refundDetail.refundDescription}}</text></view></block><view class="info-row data-v-3847af48"><text class="label data-v-3847af48">申请时间</text><text class="value data-v-3847af48">{{$root.m0}}</text></view></view><block wx:if="{{refundDetail.merchantReply}}"><view class="section reply-section data-v-3847af48"><view class="reply-header data-v-3847af48"><text class="reply-title data-v-3847af48">商家回复</text></view><view class="{{['reply-alert','data-v-3847af48',replyAlertClass]}}"><view class="reply-alert-header data-v-3847af48"><text class="reply-alert-icon data-v-3847af48">{{replyAlertIcon}}</text><text class="reply-alert-title data-v-3847af48">{{replyAlertTitle}}</text></view><text class="reply-alert-content data-v-3847af48">{{refundDetail.merchantReply}}</text></view><block wx:if="{{refundDetail.processTime}}"><text class="reply-time data-v-3847af48">{{'处理时间：'+$root.m1+''}}</text></block></view></block><block wx:if="{{isRejected}}"><view class="section action-section data-v-3847af48"><view class="action-title data-v-3847af48">后续操作</view><view class="action-buttons data-v-3847af48"><button data-event-opts="{{[['tap',[['reapplyRefund',['$event']]]]]}}" class="btn-action data-v-3847af48" bindtap="__e"><text class="btn-icon data-v-3847af48">🔄</text><text class="btn-text data-v-3847af48">再次申请退款</text></button><block wx:if="{{merchantPhone}}"><button data-event-opts="{{[['tap',[['contactMerchant',['$event']]]]]}}" class="btn-action data-v-3847af48" bindtap="__e"><text class="btn-icon data-v-3847af48">📞</text><text class="btn-text data-v-3847af48">联系商家</text></button></block></view></view></block><block wx:if="{{isApproved}}"><view class="section success-section data-v-3847af48"><view class="success-alert data-v-3847af48"><text class="success-icon data-v-3847af48">✅</text><view class="success-text data-v-3847af48"><text class="success-title data-v-3847af48">退款已通过</text><text class="success-desc data-v-3847af48">商家已通过您的退款申请，款项将原路返回</text></view></view></view></block></view></block><block wx:else><view class="error-section data-v-3847af48"><text class="error-icon data-v-3847af48">❌</text><text class="error-text data-v-3847af48">加载退款详情失败</text><button data-event-opts="{{[['tap',[['loadRefundDetail',['$event']]]]]}}" class="btn-retry data-v-3847af48" bindtap="__e">重新加载</button></view></block></block></view>