<view class="comment-list-container data-v-66e249fa"><block wx:if="{{ratingStats}}"><view class="rating-overview data-v-66e249fa"><view class="rating-left data-v-66e249fa"><text class="rating-score data-v-66e249fa">{{ratingStats.averageRating||"0.0"}}</text><text class="rating-label data-v-66e249fa">综合评分</text><view class="rating-stars data-v-66e249fa"><block wx:for="{{5}}" wx:for-item="star" wx:for-index="__i0__" wx:key="*this"><text class="{{['star','data-v-66e249fa',(star<=averageRatingRound)?'active':'']}}">★</text></block></view></view><view class="rating-right data-v-66e249fa"><block wx:for="{{ratingStats.ratingDistribution}}" wx:for-item="count" wx:for-index="index" wx:key="index"><view class="rating-bar data-v-66e249fa"><text class="bar-label data-v-66e249fa">{{5-index+"星"}}</text><view class="bar-track data-v-66e249fa"><view class="bar-fill data-v-66e249fa" style="{{'width:'+(ratingStats.totalComments>0?count/ratingStats.totalComments*100+'%':'0%')+';'}}"></view></view><text class="bar-count data-v-66e249fa">{{count}}</text></view></block></view></view></block><block wx:if="{{$root.g0>0}}"><view class="comment-list data-v-66e249fa"><block wx:for="{{$root.l0}}" wx:for-item="item" wx:for-index="__i1__" wx:key="id"><view class="comment-item data-v-66e249fa"><view class="comment-header data-v-66e249fa"><view class="user-info data-v-66e249fa"><image class="avatar data-v-66e249fa" src="{{item.$orig.userAvatar||'/static/icons/user.png'}}" mode="aspectFill"></image><text class="username data-v-66e249fa">{{item.$orig.userName||"匿名用户"}}</text></view><view class="rating-stars data-v-66e249fa"><block wx:for="{{5}}" wx:for-item="star" wx:for-index="__i2__" wx:key="*this"><text class="{{['star','data-v-66e249fa',(star<=item.$orig.rating)?'active':'']}}">★</text></block></view></view><view class="comment-content data-v-66e249fa">{{item.m0}}</view><block wx:if="{{item.$orig.replyContent}}"><view class="merchant-reply data-v-66e249fa"><view class="reply-header data-v-66e249fa"><text class="reply-icon data-v-66e249fa">🏪</text><text class="reply-label data-v-66e249fa">{{item.$orig.replyRole==="admin"?"官方回复":"商家回复"}}</text><block wx:if="{{item.$orig.replyTime}}"><text class="reply-time data-v-66e249fa">{{item.m1}}</text></block></view><view class="reply-content data-v-66e249fa">{{item.m2}}</view></view></block><text class="comment-time data-v-66e249fa">{{item.m3}}</text></view></block></view></block><block wx:else><view class="empty-state data-v-66e249fa"><text class="empty-icon data-v-66e249fa">💬</text><text class="empty-text data-v-66e249fa">暂无评价</text></view></block><block wx:if="{{loading}}"><view class="loading-more data-v-66e249fa"><text class="data-v-66e249fa">加载中...</text></view></block><block wx:if="{{$root.g1}}"><view class="no-more data-v-66e249fa"><text class="data-v-66e249fa">没有更多了</text></view></block></view>