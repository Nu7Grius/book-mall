<view class="edit-profile-container data-v-74b9143a"><view class="form-section data-v-74b9143a"><view data-event-opts="{{[['tap',[['changeAvatar',['$event']]]]]}}" class="avatar-section data-v-74b9143a" bindtap="__e"><text class="label data-v-74b9143a">头像</text><view class="avatar-wrapper data-v-74b9143a"><image class="avatar data-v-74b9143a" src="{{form.avatar||'/static/icons/user.png'}}" mode="aspectFill"></image><text class="arrow data-v-74b9143a">></text></view></view></view><view class="form-section data-v-74b9143a"><view class="form-item data-v-74b9143a"><text class="label data-v-74b9143a">用户名</text><input class="input data-v-74b9143a" placeholder="请输入用户名" disabled="{{true}}" data-event-opts="{{[['input',[['__set_model',['$0','username','$event',[]],['form']]]]]}}" value="{{form.username}}" bindinput="__e"/></view><view class="form-item data-v-74b9143a"><text class="label data-v-74b9143a">真实姓名</text><input class="input data-v-74b9143a" placeholder="请输入真实姓名" data-event-opts="{{[['input',[['__set_model',['$0','realName','$event',[]],['form']]]]]}}" value="{{form.realName}}" bindinput="__e"/></view><view class="form-item data-v-74b9143a"><text class="label data-v-74b9143a">手机号</text><input class="input data-v-74b9143a" type="number" maxlength="11" placeholder="请输入手机号" data-event-opts="{{[['input',[['__set_model',['$0','phone','$event',[]],['form']]]]]}}" value="{{form.phone}}" bindinput="__e"/></view><view class="form-item data-v-74b9143a"><text class="label data-v-74b9143a">邮箱</text><input class="input data-v-74b9143a" type="text" placeholder="请输入邮箱" data-event-opts="{{[['input',[['__set_model',['$0','email','$event',[]],['form']]]]]}}" value="{{form.email}}" bindinput="__e"/></view><view class="form-item data-v-74b9143a"><text class="label data-v-74b9143a">性别</text><picker mode="selector" range="{{genderOptions}}" range-key="label" value="{{form.gender}}" data-event-opts="{{[['change',[['onGenderChange',['$event']]]]]}}" bindchange="__e" class="data-v-74b9143a"><view class="picker-value data-v-74b9143a">{{''+genderOptions[form.gender].label+''}}<text class="picker-arrow data-v-74b9143a">▼</text></view></picker></view><view class="form-item data-v-74b9143a"><text class="label data-v-74b9143a">年龄</text><input class="input data-v-74b9143a" type="number" maxlength="3" placeholder="请输入年龄" data-event-opts="{{[['input',[['__set_model',['$0','age','$event',[]],['form']]]]]}}" value="{{form.age}}" bindinput="__e"/></view></view><view class="btn-wrapper data-v-74b9143a"><button data-event-opts="{{[['tap',[['saveProfile',['$event']]]]]}}" class="btn-save data-v-74b9143a" bindtap="__e">保存</button></view></view>