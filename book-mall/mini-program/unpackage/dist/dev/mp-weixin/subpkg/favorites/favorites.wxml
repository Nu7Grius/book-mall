text class="empty-text data-v-b1fb00ac">{{searchKey?"未找到匹配的图书":"暂无收藏"}}</text><button data-event-opts="{{[['tap',[['e0',['$event']]]]]}}" class="btn-go-browse data-v-b1fb00ac" bindtap="__e">{{''+(searchKey?"清除搜索":"去逛逛")+''}}</button></view></block></block><block wx:if="{{loading}}"><view class="loading-more data-v-b1fb00ac"><text class="data-v-b1fb00ac">加载中...</text></view></block></view>