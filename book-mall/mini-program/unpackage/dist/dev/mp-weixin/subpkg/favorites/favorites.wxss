
.favorites-container.data-v-b1fb00ac {
  min-height: 100vh;
  background-color: #f5f5f5;
  padding-top: 0;
}

/* 搜索栏 */
.search-bar.data-v-b1fb00ac {
  display: flex;
  align-items: center;
  padding: 20rpx 30rpx;
  background-color: #fff;
  border-bottom: 1rpx solid #f0f0f0;
}
.search-input.data-v-b1fb00ac {
  flex: 1;
  display: flex;
  align-items: center;
  height: 64rpx;
  background-color: #f5f5f5;
  border-radius: 32rpx;
  padding: 0 24rpx;
}
.search-input .icon.data-v-b1fb00ac {
  font-size: 26rpx;
  margin-right: 12rpx;
}
.search-input input.data-v-b1fb00ac {
  flex: 1;
  font-size: 26rpx;
}
.cancel-btn.data-v-b1fb00ac {
  font-size: 28rpx;
  color: #15803d;
  margin-left: 20rpx;
}

/* 收藏列表 */
.favorites-list.data-v-b1fb00ac {
  display: flex;
  flex-direction: column;
  padding: 20rpx;
}
.favorite-item.data-v-b1fb00ac {
  display: flex;
  background-color: #fff;
  border-radius: 16rpx;
  padding: 24rpx;
  margin-bottom: 20rpx;
}
.book-cover.data-v-b1fb00ac {
  width: 160rpx;
  height: 220rpx;
  border-radius: 12rpx;
  background-color: #f5f5f5;
  flex-shrink: 0;
}
.book-info.data-v-b1fb00ac {
  flex: 1;
  margin-left: 24rpx;
  display: flex;
  flex-direction: column;
}
.book-name.data-v-b1fb00ac {
  font-size: 28rpx;
  color: #333;
  font-weight: 500;
  display: -webkit-box;
  -webkit-box-orient: vertical;
  -webkit-line-clamp: 2;
  overflow: hidden;
}
.book-author.data-v-b1fb00ac {
  font-size: 24rpx;
  color: #999;
  margin-top: 8rpx;
}
.book-bottom.data-v-b1fb00ac {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-top: auto;
  padding-top: 16rpx;
}
.book-price.data-v-b1fb00ac {
  font-size: 30rpx;
  color: #15803d;
  font-weight: bold;
}
.btn-add-cart.data-v-b1fb00ac {
  height: 56rpx;
  line-height: 56rpx;
  background-color: #15803d;
  color: #fff;
  border-radius: 28rpx;
  font-size: 24rpx;
  padding: 0 24rpx;
  border: none;
}
.delete-btn.data-v-b1fb00ac {
  padding: 10rpx 20rpx;
  color: #15803d;
  font-size: 26rpx;
  align-self: flex-start;
}
.empty-state.data-v-b1fb00ac {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: 200rpx 0;
}
.empty-icon.data-v-b1fb00ac {
  font-size: 120rpx;
  margin-bottom: 30rpx;
}
.empty-text.data-v-b1fb00ac {
  font-size: 28rpx;
  color: #999;
  margin-bottom: 40rpx;
}
.btn-go-browse.data-v-b1fb00ac {
  width: 240rpx;
  height: 72rpx;
  background-color: #15803d;
  color: #fff;
  border-radius: 36rpx;
  font-size: 28rpx;
}
.loading-more.data-v-b1fb00ac {
  text-align: center;
  padding: 30rpx;
  font-size: 26rpx;
  color: #999;
}

