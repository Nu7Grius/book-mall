<view class="refund-container data-v-0804e71a"><block wx:if="{{order}}"><view class="order-section data-v-0804e71a"><view class="section-title data-v-0804e71a">订单信息</view><view class="order-info data-v-0804e71a"><text class="order-id data-v-0804e71a">{{"订单号："+(order.orderNo||order.orderNumber||"无")}}</text></view></view></block><block wx:if="{{singleItem}}"><view class="single-item-section data-v-0804e71a"><view class="section-title data-v-0804e71a">退款商品</view><view class="single-item-card data-v-0804e71a"><image class="item-cover data-v-0804e71a" src="{{singleItem.coverImage}}" mode="aspectFill"></image><view class="item-info data-v-0804e71a"><text class="item-name data-v-0804e71a">{{singleItem.bookName||singleItem.bookTitle||"未知书名"}}</text><block wx:if="{{singleItem.author}}"><text class="item-author data-v-0804e71a">{{singleItem.author}}</text></block><view class="item-bottom data-v-0804e71a"><text class="item-price data-v-0804e71a">{{"¥"+(singleItem.price||0)}}</text><text class="item-quantity data-v-0804e71a">{{"x"+(singleItem.quantity||1)}}</text></view></view></view></view></block><block wx:else><view class="items-section data-v-0804e71a"><view class="section-title data-v-0804e71a">选择退款商品</view><block wx:for="{{$root.l0}}" wx:for-item="item" wx:for-index="__i0__" wx:key="id"><view data-event-opts="{{[['tap',[['toggleSelectItem',['$0'],[[['orderItems','id',item.$orig.id]]]]]]]}}" class="{{['item-card','data-v-0804e71a',(item.g0)?'selected':'']}}" bindtap="__e"><view class="checkbox data-v-0804e71a"><block wx:if="{{item.g1}}"><text class="data-v-0804e71a">✓</text></block></view><image class="item-cover data-v-0804e71a" src="{{item.$orig.coverImage}}" mode="aspectFill"></image><view class="item-info data-v-0804e71a"><text class="item-name data-v-0804e71a">{{item.$orig.bookName}}</text><view class="item-bottom data-v-0804e71a"><text class="item-price data-v-0804e71a">{{"¥"+item.$orig.price}}</text><text class="item-quantity data-v-0804e71a">{{"x"+item.$orig.quantity}}</text></view></view></view></block></view></block><view class="reason-section data-v-0804e71a"><view class="section-title data-v-0804e71a">退款原因</view><view class="reason-type data-v-0804e71a"><picker range="{{reasonTypes}}" range-key="label" value="{{reasonTypeIndex}}" data-event-opts="{{[['change',[['onReasonTypeChange',['$event']]]]]}}" bindchange="__e" class="data-v-0804e71a"><view class="picker-value data-v-0804e71a"><text class="data-v-0804e71a">{{reasonTypes[reasonTypeIndex].label}}</text><text class="arrow data-v-0804e71a">></text></view></picker></view><textarea class="reason-textarea data-v-0804e71a" placeholder="请详细描述退款原因（选填）" maxlength="200" data-event-opts="{{[['input',[['__set_model',['','reasonDescription','$event',[]]]]]]}}" value="{{reasonDescription}}" bindinput="__e"></textarea></view><view class="amount-section data-v-0804e71a"><view class="section-title data-v-0804e71a">退款金额</view><view class="amount-display data-v-0804e71a"><text class="amount-label data-v-0804e71a">预计退款：</text><text class="amount-value data-v-0804e71a">{{"¥"+refundAmount}}</text></view></view><view class="submit-section data-v-0804e71a"><button class="btn-submit data-v-0804e71a" disabled="{{$root.g2}}" data-event-opts="{{[['tap',[['submitRefund',['$event']]]]]}}" bindtap="__e">{{''+(submitting?"提交中...":"提交退款申请")+''}}</button></view></view>