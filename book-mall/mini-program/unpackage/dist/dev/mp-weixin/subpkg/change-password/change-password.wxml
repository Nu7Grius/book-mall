<view class="change-password-container data-v-55dfedac"><view class="form-section data-v-55dfedac"><view class="form-item data-v-55dfedac"><text class="label data-v-55dfedac">原密码</text><input class="input data-v-55dfedac" type="password" placeholder="请输入原密码" password="{{true}}" data-event-opts="{{[['input',[['__set_model',['$0','oldPassword','$event',[]],['form']]]]]}}" value="{{form.oldPassword}}" bindinput="__e"/></view><view class="form-item data-v-55dfedac"><text class="label data-v-55dfedac">新密码</text><input class="input data-v-55dfedac" type="password" placeholder="请输入新密码" password="{{true}}" data-event-opts="{{[['input',[['__set_model',['$0','newPassword','$event',[]],['form']]]]]}}" value="{{form.newPassword}}" bindinput="__e"/></view><view class="form-item data-v-55dfedac"><text class="label data-v-55dfedac">确认密码</text><input class="input data-v-55dfedac" type="password" placeholder="请再次输入新密码" password="{{true}}" data-event-opts="{{[['input',[['__set_model',['$0','confirmPassword','$event',[]],['form']]]]]}}" value="{{form.confirmPassword}}" bindinput="__e"/></view></view><view class="tips data-v-55dfedac"><text class="tip-text data-v-55dfedac">密码要求：</text><text class="tip-text data-v-55dfedac">1. 密码长度至少6位</text><text class="tip-text data-v-55dfedac">2. 新密码不能与原密码相同</text></view><view class="btn-wrapper data-v-55dfedac"><button data-event-opts="{{[['tap',[['submitPassword',['$event']]]]]}}" class="btn-submit data-v-55dfedac" bindtap="__e">确认修改</button></view></view>